<view class="page">
  <view class="rep-head">
    <view class="rep-title">
      {{isCoachView ? athleteName + ' 的周报' : '我的周报'}}
      <text class="tiny"> {{weekLabel}}</text>
      <text class="tiny" wx:if="{{w}}"> {{w.phaseLabel}}</text>
    </view>
    <view class="tiny">{{fromDate}} ~ {{endDate}}</view>
    <view class="source-badge {{source === 'local' ? 'local' : 'cloud'}}" wx:if="{{w && sourceLabel}}">{{sourceLabel}}</view>
  </view>

  <view class="demo-banner" wx:if="{{isDemo}}">
    <text class="demo-tag">演示数据</text>
    <text>本周报基于演示记录生成，不是真实训练数据。保存任意一天的真实记录后，演示数据会自动移除。</text>
  </view>

  <view class="week-nav">
    <text class="nav" bindtap="prevWeek">‹ 上一周</text>
    <text class="nav" bindtap="thisWeek">本周</text>
    <text class="nav" bindtap="nextWeek">下一周 ›</text>
  </view>

  <block wx:if="{{w}}">
    <!-- 四个关键数字 -->
    <view class="grid">
      <view class="cell">
        <view class="cell-label">晨重</view>
        <view class="cell-val">{{w.weight.lastKg === null ? '--' : w.weight.lastKg}}<text class="cell-unit">kg</text></view>
        <view class="tiny" wx:if="{{w.weight.deltaKg !== null}}">周内 {{w.weight.deltaKg > 0 ? '+' : ''}}{{w.weight.deltaKg}}kg</view>
      </view>
      <view class="cell">
        <view class="cell-label">周速率</view>
        <view class="cell-val {{w.weight.weeklyPct > 1 ? 'v-red' : ''}}">{{w.weight.weeklyRate === null ? '--' : w.weight.weeklyRate}}<text class="cell-unit">kg/周</text></view>
        <view class="tiny" wx:if="{{w.weight.weeklyPct !== null}}">{{w.weight.weeklyPct}}% 体重</view>
      </view>
      <view class="cell">
        <view class="cell-label">蛋白达标</view>
        <view class="cell-val {{w.protein.rate < 85 ? 'v-amber' : 'v-ok'}}">{{w.protein.rate === null ? '--' : w.protein.rate}}<text class="cell-unit">%</text></view>
        <view class="tiny" wx:if="{{w.protein.knownDays}}">{{w.protein.okDays}}/{{w.protein.knownDays}} 天 · 均 {{w.protein.avgG}}g</view>
      </view>
      <view class="cell">
        <view class="cell-label">训练负荷</view>
        <view class="cell-val">{{w.load.total}}<text class="cell-unit">sRPE</text></view>
        <view class="tiny">{{w.load.sessions}} 次课 · 睡眠 {{w.sleep.avg === null ? '--' : w.sleep.avg}}h</view>
      </view>
    </view>

    <!-- 结论 -->
    <view class="card">
      <view class="card-title">这周发生了什么<text class="tiny">{{w.loggedDays}}/{{w.days}} 天有记录</text></view>
      <view class="concl" wx:for="{{w.conclusions}}" wx:key="*this">· {{item}}</view>
      <view class="tiny" wx:if="{{w.completeDays < w.loggedDays}}">其中 {{w.loggedDays - w.completeDays}} 天缺本阶段必填项，相关结论只能算"部分"</view>
    </view>

    <!-- 规则触发 -->
    <view class="card" wx:if="{{w.ruleHits.length}}">
      <view class="card-title">哪条规则最常触发<text class="tiny">按红灯数排序</text></view>
      <view class="hit" wx:for="{{w.ruleHits}}" wx:key="ruleId">
        <view class="hit-top">
          <text class="rid">{{item.ruleId}}</text>
          <text class="hit-name">{{item.name}}</text>
          <text class="hit-count">{{item.count}} 天</text>
        </view>
        <view class="hit-bar"><view class="hit-fill {{item.red ? 'red' : 'amber'}}" style="width:{{item.count / maxHit * 100}}%"></view></view>
      </view>
      <view class="tiny">点单项展开"依据"可看到规则 ID 与文献锚点（今日页 / 规则库）</view>
    </view>

    <!-- 与上一周对比 -->
    <view class="card">
      <view class="card-title">
        与上一周对比
        <text class="tiny" wx:if="{{cmp.prevAvailable}}">{{cmp.prevFromDate}} ~ {{cmp.prevEndDate}}</text>
      </view>
      <block wx:if="{{cmp.prevAvailable}}">
        <view class="cmp-row" wx:for="{{cmp.rows}}" wx:key="key">
          <view class="cmp-top">
            <text class="cmp-label">{{item.label}}</text>
            <text class="cmp-delta {{item.tone}}">{{item.deltaText}}</text>
          </view>
          <view class="tiny">本周 {{item.curText}} · 上周 {{item.prevText}}</view>
        </view>
        <view class="tiny">上一周按当前的阶段口径重算，仅用于趋势对照。</view>
      </block>
      <view class="tiny cmp-empty" wx:else>上周无数据可对比（不按 0 计算）。</view>
    </view>

    <!-- 下周 -->
    <view class="card">
      <view class="card-title">下周先做这几件</view>
      <view class="next" wx:for="{{w.nextWeek}}" wx:key="*this">{{index + 1}}. {{item}}</view>
    </view>

    <button class="btn" bindtap="exportPoster" loading="{{exporting}}" disabled="{{exporting}}">{{exporting ? '正在生成长图…' : '生成长图（预览 / 保存）'}}</button>
    <button class="btn ghost" bindtap="savePoster" wx:if="{{hasPoster}}">保存长图到相册{{posterCount > 1 ? '（共 ' + posterCount + ' 张）' : ''}}</button>
    <view class="tiny center" wx:if="{{hasPoster}}">长图与复制文本使用同一份数据；预览页也可长按保存</view>
    <button class="btn ghost" bindtap="copyText" style="margin-top:12rpx">复制周报文本（发给教练）</button>
    <button class="btn ghost" bindtap="goLog" style="margin-top:12rpx">补记今天的记录</button>
    <view class="tiny center" style="margin:20rpx 0 40rpx">周报只统计有记录的日期；缺记录的天不会当成"做得不好"</view>
  </block>

  <view class="empty" wx:if="{{!w && !loading}}">
    <view class="empty-title">{{emptyTitle || '这一周还没有记录'}}</view>
    <view class="tiny">{{emptyHint}}</view>
    <view class="empty-ops">
      <button class="btn ghost mini" wx:if="{{isCoachView}}" bindtap="goBackCoach">返回拳王详情</button>
      <button class="btn ghost mini" bindtap="prevWeek">改查上一周</button>
      <button class="btn ghost mini" wx:if="{{!isCoachView}}" bindtap="goLog">补记今天的记录</button>
      <button class="btn mini" wx:if="{{error}}" bindtap="load">重试</button>
    </view>
  </view>

  <!-- 离屏画布：长图在此绘制后导出，不参与页面布局 -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas" aria-hidden="true" />
</view>
