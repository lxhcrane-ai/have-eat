.top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20rpx; }
.date { font-size: 36rpx; font-weight: 700; }
.inbox { background: #2a1a12; color: #ffc46b; border-radius: 999rpx; padding: 8rpx 20rpx; font-size: 22rpx; display: flex; align-items: center; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #ff7a6b; margin-right: 10rpx; }
.score-card { display: flex; align-items: center; gap: 28rpx; }
.score-left { text-align: center; min-width: 150rpx; }
.score-num { font-size: 78rpx; font-weight: 800; line-height: 1; }
.score-level { font-size: 24rpx; margin-top: 8rpx; }
.tone-ok { color: #5ce39a; }
.tone-amber { color: #ffc46b; }
.tone-red { color: #ff7a6b; }
.tone-info { color: #6bc4ff; }
.score-right { flex: 1; }
.headline { font-size: 28rpx; line-height: 1.5; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.cell { width: calc(33.33% - 11rpx); background: #161a18; border: 1rpx solid #242b28; border-radius: 16rpx; padding: 18rpx 16rpx; box-sizing: border-box; }
.cell-label { color: #8a968f; font-size: 22rpx; }
.cell-val { font-size: 40rpx; font-weight: 700; margin-top: 4rpx; }
.cell-unit { font-size: 20rpx; color: #8a968f; font-weight: 400; margin-left: 4rpx; }
.v-red { color: #ff7a6b; }
.v-amber { color: #ffc46b; }
.alert { border-left: 6rpx solid #2a3330; padding: 16rpx 0 16rpx 18rpx; margin-top: 14rpx; }
.alert.a-red { border-color: #ff7a6b; }
.alert.a-amber { border-color: #ffc46b; }
.alert.a-info { border-color: #3a5a6b; }
.alert-head { display: flex; align-items: center; gap: 12rpx; }
.alert-title { font-weight: 600; font-size: 27rpx; flex: 1; }
.alert-body { color: #b9c4be; font-size: 25rpx; margin-top: 8rpx; line-height: 1.6; }
.kb-ref { margin-top: 12rpx; padding: 12rpx 16rpx; background: #0f1211; border-radius: 10rpx; }
.kb-line { color: #8a968f; font-size: 22rpx; margin-top: 6rpx; }
.tip { padding: 16rpx 0; border-bottom: 1rpx solid #1f2523; }
.tip:last-child { border-bottom: none; }
.tip-title { font-weight: 600; font-size: 27rpx; color: #e8ff47; }
.tip-body { color: #b9c4be; font-size: 25rpx; margin: 8rpx 0; line-height: 1.6; }
.actions { display: flex; gap: 16rpx; margin-top: 10rpx; }
.actions .btn { flex: 1; }

.coach-remind { border: 1rpx solid #2c4a33; background: #101a14; }
.remind-text { font-size: 27rpx; line-height: 1.6; color: #d9f5e4; margin: 8rpx 0; }
.warn { border: 1rpx solid #4a3a12; background: #1a160c; }
.warn-line { color: #ffc46b; font-size: 24rpx; margin-top: 6rpx; }

.advice { border: 1rpx solid #2f4a36; background: #101a14; }
.advice-title { display: flex; align-items: center; gap: 10rpx; }
.adv-link { margin-left: auto; color: #6bc4ff; font-size: 22rpx; font-weight: 400; }
.advice-meta { margin-bottom: 8rpx; }
.advice-body { font-size: 28rpx; line-height: 1.7; color: #e9eeec; white-space: pre-wrap; }
.advice-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.chip.sm { padding: 6rpx 16rpx; font-size: 22rpx; }
.advice-offline { color: #ffc46b; margin-top: 10rpx; }
.advice-hint { color: #8a968f; margin: 0 0 16rpx; line-height: 1.5; }
.section-label { color: #6b7772; font-size: 22rpx; margin: 6rpx 0 12rpx; }
.badge.update { background: #2a3a12; color: #e8ff47; }

.goal-card { border-color: #2a3a2f; }
.goal-lead { font-size: 30rpx; font-weight: 700; color: #e8ff47; margin: 6rpx 0 10rpx; }
.goal-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 6rpx; }
.goal-sub { margin-top: 6rpx; }
.goal-weak { color: #ffc46b; margin-top: 10rpx; line-height: 1.5; }
.adh-head { display: flex; align-items: baseline; gap: 16rpx; margin: 6rpx 0 4rpx; }
.adh-score { font-size: 52rpx; font-weight: 800; }
.adh-level { font-size: 24rpx; }
.adh-row { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx solid #1f2523; }
.adh-row:last-child { border-bottom: none; }
.adh-label { font-size: 25rpx; color: #b9c4be; }
.adh-hint { color: #8a968f; margin-top: 8rpx; line-height: 1.5; }
