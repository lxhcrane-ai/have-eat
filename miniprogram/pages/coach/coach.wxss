.coach-head { margin-bottom: 18rpx; }
.title { font-size: 38rpx; font-weight: 700; }
.ath-head { display: flex; justify-content: space-between; align-items: center; }
.ath-name { font-size: 32rpx; font-weight: 700; }
.ath-score { font-size: 54rpx; font-weight: 800; }
.ath-level { font-size: 22rpx; margin-left: 8rpx; }
.tone-ok { color: #5ce39a; } .tone-amber { color: #ffc46b; } .tone-red { color: #ff7a6b; } .tone-info { color: #6bc4ff; }
.ath-sum { color: #b9c4be; font-size: 24rpx; margin: 12rpx 0; line-height: 1.6; }
.alert-mini { font-size: 24rpx; color: #ffb3aa; padding: 6rpx 0; }
.ath-ops { display: flex; gap: 24rpx; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #1f2523; }
.op { color: #6bc4ff; font-size: 24rpx; }
.d-row { display: flex; justify-content: space-between; gap: 16rpx; padding: 14rpx 0; border-top: 1rpx solid #1a201e; }
.d-date { font-weight: 600; font-size: 25rpx; }
.d-left { flex: 1; }
.d-right { text-align: right; color: #8a968f; }

.queue-hero { display: flex; justify-content: space-between; align-items: center; border: 1rpx solid #2a3a30; background: #101a14; }
.qh-num { font-size: 64rpx; font-weight: 800; color: #e8ff47; margin-right: 10rpx; }
.qh-label { font-size: 26rpx; color: #b9c4be; }
.qh-right .op { color: #6bc4ff; font-size: 26rpx; }
.link-row { text-align: right; margin: -8rpx 0 16rpx; }
.phase-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; margin: 10rpx 0; }
.chip.sm { font-size: 22rpx; padding: 6rpx 16rpx; }
