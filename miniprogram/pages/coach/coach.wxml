<view class="page">
  <view class="card" wx:if="{{error}}">
    <view class="card-title">加载失败</view>
    <view class="tiny">{{error}}</view>
    <button class="btn ghost" bindtap="load" style="margin-top:16rpx">重试</button>
  </view>

  <block wx:if="{{isCoach}}">
    <view class="coach-head">
      <view>
        <view class="title">营养师后台</view>
        <view class="tiny">{{athletes.length}} 名拳王 · 下拉刷新</view>
      </view>
    </view>

    <!-- 第一眼：今天需要处理几件事 -->
    <view class="card queue-hero" bindtap="goQueue">
      <view>
        <text class="qh-num">{{queue.pending}}</text>
        <text class="qh-label">件事待处理</text>
        <view class="tiny" wx:if="{{queue.escalated}}">{{queue.escalated}} 项已升级为人工介入</view>
        <view class="tiny" wx:if="{{!queue.escalated}}">没有升级项</view>
      </view>
      <view class="qh-right">
        <text class="op">跟进队列 ›</text>
      </view>
    </view>
    <view class="link-row">
      <text class="op" bindtap="goRules">规则库与文献锚点 ›</text>
    </view>

    <view class="empty" wx:if="{{!athletes.length}}">
      <view>还没有拳王绑定你</view>
      <view class="tiny" style="margin:16rpx 0">让拳王在「我的 → 绑定教练」输入同一个邀请码</view>
      <button class="btn ghost" bindtap="goBind">查看邀请码设置</button>
    </view>

    <view class="card ath" wx:for="{{athletes}}" wx:key="openid">
      <view class="ath-head" data-id="{{item.openid}}" bindtap="openDetail">
        <view class="ath-left">
          <text class="ath-name">{{item.name}}</text>
          <text class="tiny"> {{item.date}}</text>
          <view class="tiny">{{item.targets}}</view>
        </view>
        <view class="ath-score tone-{{item.tone}}">{{item.score}}<text class="ath-level">{{item.level}}</text></view>
      </view>

      <view class="ath-sum">{{item.summary}}</view>

      <!-- 阶段由营养师在这里切换，拳王端只读 -->
      <view class="phase-row">
        <text class="tiny">阶段</text>
        <view class="chip sm {{item.phase === p.id ? 'on' : ''}}" wx:for="{{phases}}" wx:for-item="p" wx:for-index="pi" wx:key="id" data-id="{{item.openid}}" data-phase="{{p.id}}" bindtap="setPhase">{{p.name}}</view>
      </view>

      <view class="alert-mini" wx:for="{{item.reds}}" wx:key="title" wx:for-item="r">
        <text class="badge red">必须</text> {{r.title}}
      </view>

      <view class="ath-ops">
        <text class="op" data-id="{{item.openid}}" data-name="{{item.name}}" catchtap="goChat">发消息</text>
        <text class="op" data-id="{{item.openid}}" bindtap="openDetail">{{detailOpen === item.openid ? '收起' : '看最近 14 天'}}</text>
      </view>

      <block wx:if="{{detailOpen === item.openid}}">
        <view class="d-row" wx:for="{{detailLogs}}" wx:key="date" wx:for-item="d">
          <view class="d-left">
            <text class="d-date">{{d.date}}</text>
            <view class="tiny">{{d.headline}}</view>
          </view>
          <view class="d-right tiny">
            <view>{{d.kg}}kg · 脱水 {{d.dehydration === null ? '--' : d.dehydration}}%</view>
            <view>P {{d.protein}}/{{d.target}}g · 酸痛 {{d.soreness === null ? '--' : d.soreness}}</view>
            <view>sRPE {{d.srpe || '--'}} · {{d.score}} 分</view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <view class="card" wx:if="{{!isCoach && !loading}}">
    <view class="card-title">当前是拳王账号</view>
    <view class="tiny">教练端需要先开启教练身份。用一个邀请码把两边接上。</view>
    <button class="btn ghost" bindtap="goBind" style="margin-top:16rpx">开启教练端</button>
    <button class="btn ghost" bindtap="goHome" style="margin-top:12rpx">回首页</button>
  </view>
</view>
