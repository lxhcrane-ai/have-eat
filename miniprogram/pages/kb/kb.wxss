.cats { white-space: nowrap; margin-bottom: 8rpx; }
.search-card { padding: 20rpx; }
.item-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16rpx; }
.item-title { font-size: 28rpx; font-weight: 600; color: #e8ff47; flex: 1; }
.item-body { color: #b9c4be; font-size: 25rpx; line-height: 1.65; margin-top: 10rpx; }
.clamp { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.src { margin-top: 14rpx; padding-top: 12rpx; border-top: 1rpx solid #1f2523; color: #6b7772; font-size: 21rpx; line-height: 1.5; }
