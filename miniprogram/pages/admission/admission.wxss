.page { padding: 32rpx 28rpx 80rpx; background: #f5f6f8; min-height: 100vh; box-sizing: border-box; }

.hero {
  background: #1f2937;
  color: #fff;
  border-radius: 20rpx;
  padding: 44rpx 32rpx;
  margin-bottom: 28rpx;
}
.hero-kicker { font-size: 22rpx; letter-spacing: 4rpx; opacity: .65; margin-bottom: 14rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; margin-bottom: 18rpx; }
.hero-desc { font-size: 26rpx; line-height: 1.7; opacity: .85; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, .05);
}
.card-title { font-size: 30rpx; font-weight: 700; color: #111827; margin-bottom: 16rpx; }
.tiny { font-size: 24rpx; line-height: 1.65; color: #6b7280; }

.code-input {
  margin: 24rpx 0;
  height: 88rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  background: #fafafa;
}

.btn {
  background: #111827;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}
.btn.ghost { background: #fff; color: #111827; border: 2rpx solid #d1d5db; margin-top: 20rpx; }

.switch-row { text-align: center; margin-top: 22rpx; font-size: 26rpx; color: #9ca3af; }
.link { color: #2563eb; padding: 8rpx 12rpx; }
.dot { margin: 0 6rpx; }

.warn { margin-top: 18rpx; font-size: 26rpx; line-height: 1.6; color: #b45309; }
.rule { font-size: 25rpx; line-height: 1.7; color: #4b5563; margin-bottom: 10rpx; }
