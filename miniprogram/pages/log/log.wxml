<view class="page">
  <view class="head">
    <picker mode="date" value="{{draft.date}}" bindchange="onDate">
      <view class="date-pick">{{draft.date}} <text class="tiny">切换</text></view>
    </picker>
    <view class="preview">{{preview}}</view>
  </view>

  <!-- 演示记录：保存后转为真实记录，避免把演示数字当成真实数据 -->
  <view class="demo-banner" wx:if="{{isDemo}}">
    <text class="demo-tag">演示记录</text>
    <text>这一天的数字是演示数据，不是你的真实记录。保存后即转为真实记录，其余演示数据会被移除。</text>
  </view>

  <!-- 轻量横幅：营养师已审阅，不重复正文 -->
  <view class="review-banner" wx:if="{{reviewed}}" bindtap="goHome">
    <text>营养师已审阅今日建议</text>
    <text class="op">查看 ›</text>
  </view>

  <!-- 阶段条：阶段由营养师设置，决定下面哪些字段必填 -->
  <view class="phase-bar">
    <view class="phase-name">{{phaseLabel}}</view>
    <view class="tiny">{{phaseGoal}}</view>
    <view class="tiny req" wx:if="{{phaseRequired.length}}">本阶段必填：
      <text wx:for="{{phaseRequired}}" wx:key="key">{{item.label}}{{index === phaseRequired.length - 1 ? '' : '、'}}</text>
    </view>
  </view>

  <!-- 体重 -->
  <view class="card">
    <view class="card-title">体重<text class="tiny">同条件、空腹、如厕后</text></view>
    <view class="row">
      <text class="label">晨重（空腹）</text>
      <view class="input-wrap">
        <input class="input num" type="digit" value="{{draft.weights.morning.kg}}" data-k="weights.morning.kg" bindinput="onNum" placeholder="0.0" />
        <text class="unit">kg</text>
      </view>
    </view>
    <view class="row">
      <text class="label">训练前</text>
      <view class="input-wrap">
        <input class="input num" type="digit" value="{{draft.weights.pre.kg}}" data-k="weights.pre.kg" bindinput="onNum" placeholder="0.0" />
        <text class="unit">kg</text>
      </view>
    </view>
    <view class="row">
      <text class="label">训练后</text>
      <view class="input-wrap">
        <input class="input num" type="digit" value="{{draft.weights.post.kg}}" data-k="weights.post.kg" bindinput="onNum" placeholder="0.0" />
        <text class="unit">kg</text>
      </view>
    </view>
  </view>

  <!-- 睡眠 / 水合 -->
  <view class="card">
    <view class="card-title">睡眠与水合</view>
    <view class="row">
      <text class="label">睡眠时长</text>
      <view class="input-wrap">
        <input class="input num" type="digit" value="{{draft.sleep.hours}}" data-k="sleep.hours" bindinput="onNum" placeholder="7.5" />
        <text class="unit">小时</text>
      </view>
    </view>
    <view class="sub-label">睡眠质量</view>
    <view class="chips">
      <view class="chip {{draft.sleep.quality == item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-k="sleep.quality" data-v="{{item}}" bindtap="onPick">{{item}}</view>
    </view>
    <view class="row">
      <text class="label">已饮水</text>
      <view class="input-wrap">
        <input class="input num" type="number" value="{{draft.hydration.waterMl}}" data-k="hydration.waterMl" bindinput="onNum" placeholder="1500" />
        <text class="unit">ml</text>
      </view>
    </view>
    <view class="row">
      <text class="label">晨尿颜色</text>
      <view class="input-wrap">
        <text class="tiny">1 透明 → 8 深褐</text>
      </view>
    </view>
    <view class="chips">
      <view class="chip {{draft.hydration.urineColor == item ? 'on' : ''}}" wx:for="{{urineTones}}" wx:key="*this" data-k="hydration.urineColor" data-v="{{item}}" bindtap="onPick">{{item}}</view>
    </view>
    <view class="row">
      <text class="label">晨脉</text>
      <view class="input-wrap">
        <input class="input num" type="number" value="{{draft.restingHr}}" data-k="restingHr" bindinput="onNum" placeholder="58" />
        <text class="unit">次/分</text>
      </view>
    </view>
  </view>

  <!-- 微调期专用：阶段把"脱水百分比"换成"计划执行率" -->
  <view class="card" wx:if="{{phaseId === 'peak'}}">
    <view class="card-title">微调期：补液计划执行<text class="tiny">本阶段不看脱水百分比</text></view>
    <view class="row">
      <text class="label">计划补液量</text>
      <view class="input-wrap">
        <input class="input num" type="number" value="{{draft.hydrationPlan.planMl}}" data-k="hydrationPlan.planMl" bindinput="onNum" placeholder="3000" />
        <text class="unit">ml</text>
      </view>
    </view>
    <view class="row">
      <text class="label">实际完成</text>
      <view class="input-wrap">
        <input class="input num" type="number" value="{{draft.hydrationPlan.actualMl}}" data-k="hydrationPlan.actualMl" bindinput="onNum" placeholder="2800" />
        <text class="unit">ml</text>
      </view>
    </view>
    <view class="row">
      <text class="label">用含钠液体</text>
      <switch checked="{{draft.hydrationPlan.sodiumOk}}" data-k="hydrationPlan.sodiumOk" bindchange="onBool" color="#e8ff47" />
    </view>
    <view class="sub-label">胃肠症状（0 无 – 4 严重）</view>
    <view class="sore-row" wx:for="{{giList}}" wx:key="key">
      <text class="label">{{item.name}}</text>
      <slider class="sore-slider" min="0" max="4" step="1" value="{{item.v}}" activeColor="{{item.v >= 3 ? '#ff7a6b' : '#e8ff47'}}" backgroundColor="#2a3330" block-size="18" data-k="{{item.key}}" bindchange="onGi" />
      <text class="sore-val">{{item.v}}</text>
    </view>
    <view class="sub-label">补剂：计划 / 今天已执行</view>
    <view class="supp-row" wx:for="{{suppList}}" wx:key="id">
      <text class="label">{{item.name}}</text>
      <view class="chip {{item.planned ? 'on' : ''}}" data-kind="planned" data-id="{{item.id}}" bindtap="toggleSupp">计划</view>
      <view class="chip {{item.taken ? 'on' : ''}}" data-kind="taken" data-id="{{item.id}}" bindtap="toggleSupp">执行</view>
    </view>
  </view>

  <!-- 恢复期专用：称重后补液补糖 -->
  <view class="card" wx:if="{{phaseId === 'recover'}}">
    <view class="card-title">称重后恢复<text class="tiny">补液补糖，把体重拉回比赛水平</text></view>
    <view class="row">
      <text class="label">称重时体重</text>
      <view class="input-wrap">
        <input class="input num" type="digit" value="{{draft.postWeighIn.weighInKg}}" data-k="postWeighIn.weighInKg" bindinput="onNum" placeholder="54.0" />
        <text class="unit">kg</text>
      </view>
    </view>
    <view class="row">
      <text class="label">称重后补液</text>
      <view class="input-wrap">
        <input class="input num" type="number" value="{{draft.postWeighIn.fluidMl}}" data-k="postWeighIn.fluidMl" bindinput="onNum" placeholder="1200" />
        <text class="unit">ml</text>
      </view>
    </view>
    <view class="row">
      <text class="label">用了含钠液体</text>
      <switch checked="{{draft.postWeighIn.fluidSodium}}" data-k="postWeighIn.fluidSodium" bindchange="onBool" color="#e8ff47" />
    </view>
    <view class="row">
      <text class="label">碳水总量</text>
      <view class="input-wrap">
        <input class="input num" type="number" value="{{draft.postWeighIn.carbG}}" data-k="postWeighIn.carbG" bindinput="onNum" placeholder="500" />
        <text class="unit">g</text>
      </view>
    </view>
    <view class="row">
      <text class="label">糖原明显耗尽</text>
      <switch checked="{{draft.postWeighIn.glycogenDepleted}}" data-k="postWeighIn.glycogenDepleted" bindchange="onBool" color="#e8ff47" />
    </view>
    <view class="sub-label">主观恢复感（1 很差 – 5 很好）</view>
    <view class="chips">
      <view class="chip {{draft.postWeighIn.subjective == item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-k="postWeighIn.subjective" data-v="{{item}}" bindtap="onPick">{{item}}</view>
    </view>
    <view class="sub-label">胃肠症状（0 无 – 4 严重）</view>
    <view class="sore-row" wx:for="{{giList}}" wx:key="key">
      <text class="label">{{item.name}}</text>
      <slider class="sore-slider" min="0" max="4" step="1" value="{{item.v}}" activeColor="{{item.v >= 3 ? '#ff7a6b' : '#e8ff47'}}" backgroundColor="#2a3330" block-size="18" data-k="{{item.key}}" bindchange="onGi" />
      <text class="sore-val">{{item.v}}</text>
    </view>
  </view>

  <!-- 训练 -->
  <view class="card">
    <view class="card-title">训练</view>
    <view class="chips">
      <view class="chip {{draft.training.sessionType === item.id ? 'on' : ''}}" wx:for="{{sessions}}" wx:key="id" data-k="training.sessionType" data-v="{{item.id}}" bindtap="onPick">{{item.name}}</view>
    </view>
    <view class="row">
      <text class="label">时长</text>
      <view class="input-wrap">
        <input class="input num" type="number" value="{{draft.training.durationMin}}" data-k="training.durationMin" bindinput="onNum" placeholder="90" />
        <text class="unit">分钟</text>
      </view>
    </view>
    <view class="sub-label">主观强度 RPE {{draft.training.rpe}} / 10</view>
    <slider min="1" max="10" step="1" value="{{draft.training.rpe}}" activeColor="#e8ff47" backgroundColor="#2a3330" block-size="20" data-k="training.rpe" bindchange="onSlider" />
    <view class="row">
      <text class="label">内容</text>
      <input class="input flex" value="{{draft.training.content}}" data-k="training.content" bindinput="onText" placeholder="有氧，手臂肩背力量" />
    </view>
    <view class="tiny" wx:if="{{draft.training.durationMin && draft.training.rpe}}">sRPE = {{draft.training.durationMin * draft.training.rpe}}</view>
  </view>

  <!-- 目标补充字段：默认收起，不改变原有填写与保存路径 -->
  <view class="card">
    <view class="card-title status-head" bindtap="toggleStatus">
      <text>训练与状态<text class="tiny">（选填）</text></text>
      <text class="op">{{statusOpen ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{statusOpen}}">
      <view class="row">
        <text class="label">训练开始时间</text>
        <picker mode="time" value="{{draft.training.startTime}}" bindchange="onTime">
          <view class="input-wrap">
            <text class="{{draft.training.startTime ? '' : 'tiny'}}">{{draft.training.startTime || '未填'}}</text>
            <text class="unit">点选</text>
          </view>
        </picker>
      </view>
      <view class="sub-label">训练主观质量（1 差 – 5 好）</view>
      <view class="chips">
        <view class="chip {{draft.training.quality == item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-k="training.quality" data-v="{{item}}" bindtap="onPick">{{item}}</view>
      </view>
      <view class="sub-label">感染症状（0 无 / 1 轻微 / 2 发热）</view>
      <view class="chips">
        <view class="chip {{draft.health.illness == item.v ? 'on' : ''}}" wx:for="{{illnessOptions}}" wx:key="v" data-k="health.illness" data-v="{{item.v}}" bindtap="onPick">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 酸痛 -->
  <view class="card">
    <view class="card-title">酸痛（0 无 – 10 无法训练）</view>
    <view class="sore-row" wx:for="{{sorenessList}}" wx:key="id">
      <text class="label">{{item.name}}</text>
      <slider class="sore-slider" min="0" max="10" step="1" value="{{item.v}}" activeColor="{{item.v >= 7 ? '#ff7a6b' : '#e8ff47'}}" backgroundColor="#2a3330" block-size="18" data-k="sorenessByArea.{{item.id}}" bindchange="onSlider" />
      <text class="sore-val">{{item.v}}</text>
    </view>
  </view>

  <!-- 心情 -->
  <view class="card">
    <view class="card-title">主观感受（1 好 – 5 差）</view>
    <view class="sub-label">疲劳</view>
    <view class="chips">
      <view class="chip {{draft.mood.fatigue == item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-k="mood.fatigue" data-v="{{item}}" bindtap="onPick">{{item}}</view>
    </view>
    <view class="sub-label">食欲</view>
    <view class="chips">
      <view class="chip {{draft.mood.appetite == item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-k="mood.appetite" data-v="{{item}}" bindtap="onPick">{{item}}</view>
    </view>
  </view>

  <!-- 餐食 -->
  <view class="card">
    <view class="card-title">餐食
      <text class="tiny">蛋白 {{totals.protein}}g · {{totals.kcal}} kcal · {{totals.count}} 餐</text>
    </view>
    <view class="meal" wx:for="{{draft.meals}}" wx:key="index" wx:for-index="i">
      <view class="meal-head">
        <view>
          <text class="meal-slot">{{item.slot === 'breakfast' ? '早餐' : (item.slot === 'lunch' ? '午餐' : (item.slot === 'dinner' ? '晚餐' : '加餐'))}}</text>
          <text class="tiny"> {{item.time}}</text>
        </view>
        <view class="meal-ops">
          <text class="op" data-i="{{i}}" bindtap="copyLastMeal">复用上次</text>
          <text class="op" data-i="{{i}}" bindtap="choosePhoto">{{item.photoLocal ? '已拍照' : '拍照'}}</text>
          <text class="op" wx:if="{{item.photoFileId}}" data-i="{{i}}" bindtap="recognize">识别</text>
          <text class="op danger" data-i="{{i}}" bindtap="removeMeal">删除</text>
        </view>
      </view>
      <image wx:if="{{item.photoLocal}}" src="{{item.photoLocal}}" class="meal-photo" mode="aspectFill" />
      <view class="food-item" wx:for="{{item.items}}" wx:key="index" wx:for-item="it" wx:for-index="j">
        <text class="fi-name">{{it.name}}</text>
        <text class="fi-gram">{{it.grams}}g</text>
        <text class="fi-kcal">{{it.kcal}}kcal · P{{it.protein}}</text>
        <text class="op danger" data-i="{{i}}" data-j="{{j}}" bindtap="removeItem">×</text>
      </view>
      <view class="add-food" data-i="{{i}}" bindtap="openPicker">＋ 添加食物</view>
    </view>
    <view class="slot-row">
      <view class="slot-btn" wx:for="{{slots}}" wx:key="id" data-slot="{{item.id}}" bindtap="addSlot">＋{{item.name}}</view>
    </view>
  </view>

  <!-- 明日计划 -->
  <view class="card">
    <view class="card-title">明日计划<text class="tiny">系统会检查与今天恢复状态是否冲突</text></view>
    <view class="chips">
      <view class="chip {{draft.nextPlan.type === item.id ? 'on' : ''}}" wx:for="{{planTypes}}" wx:key="id" data-k="nextPlan.type" data-v="{{item.id}}" bindtap="onPick">{{item.name}}</view>
    </view>
    <input class="input" value="{{draft.nextPlan.note}}" data-k="nextPlan.note" bindinput="onText" placeholder="具体内容（可选）" />
  </view>

  <button class="btn" bindtap="save" loading="{{saving}}">保存并生成反馈</button>
  <view class="tiny center" style="margin-top:16rpx">数据先存本机，联网后自动同步到教练端</view>
</view>

<!-- 食物选择弹层 -->
<view class="mask" wx:if="{{pickerOpen}}" bindtap="closePicker"></view>
<view class="sheet" wx:if="{{pickerOpen}}">
  <view class="sheet-head">
    <input class="input flex" placeholder="搜索食物（米饭、鸡胸、牛奶…）" value="{{foodQuery}}" bindinput="onFoodSearch" />
    <text class="op" bindtap="closePicker">关闭</text>
  </view>
  <scroll-view scroll-y class="food-list">
    <view class="food-row {{pickFood.id === item.id ? 'on' : ''}}" wx:for="{{foodShown}}" wx:key="id" data-id="{{item.id}}" bindtap="pickFoodItem">
      <text>{{item.name}}</text>
      <text class="tiny">{{item.kcal}}kcal · P{{item.p}} C{{item.c}} F{{item.f}} /100{{item.unit}}</text>
    </view>
  </scroll-view>
  <view class="add-bar" wx:if="{{pickFood.id}}">
    <text class="add-name">{{pickFood.name}}</text>
    <input class="input grams" type="number" value="{{pickGrams}}" bindinput="onGrams" />
    <text class="tiny">克</text>
    <button class="btn tiny-btn" bindtap="confirmAddFood">加入</button>
  </view>
</view>

<!-- 照片识别结果面板：只给候选，用户确认/改克数后才进这一餐 -->
<view class="mask" wx:if="{{visionOpen}}" bindtap="closeVision"></view>
<view class="sheet" wx:if="{{visionOpen}}">
  <view class="sheet-head">
    <text class="v-title">照片识别结果</text>
    <text class="op" bindtap="closeVision">关闭</text>
  </view>
  <view class="v-wrap">
    <view class="tiny">勾选的合计 {{visionTotal}} kcal</view>
    <view class="v-loading" wx:if="{{visionLoading}}">识别中…（通常 5–15 秒）</view>
    <view class="v-err" wx:if="{{visionError}}">{{visionError}}</view>

    <view class="v-item" wx:for="{{visionItems}}" wx:key="name" wx:for-index="vi">
      <view class="v-check {{item.checked ? 'on' : ''}}" data-idx="{{vi}}" bindtap="toggleVision">{{item.checked ? '✓' : ''}}</view>
      <view class="v-main">
        <view class="v-name">{{item.name}}<text class="tiny" wx:if="{{item.confText}}"> 置信 {{item.confText}}</text></view>
        <view class="tiny">{{item.grams === '' ? '份量未估' : '约 ' + item.grams + 'g'}} · {{item.kcal}} kcal · P{{item.protein}} C{{item.carbs}} F{{item.fat}}</view>
      </view>
      <input class="input v-grams" type="number" value="{{item.grams}}" data-idx="{{vi}}" bindinput="onVisionGrams" placeholder="克" />
    </view>

    <view class="v-warn" wx:for="{{visionWarnings}}" wx:key="*this">· {{item}}</view>
    <view class="tiny" wx:if="{{visionNote}}">模型说明：{{visionNote}}</view>
    <view class="tiny v-tip">{{visionDisclaimer}}</view>

    <button class="btn" wx:if="{{!visionLoading && !visionError}}" bindtap="confirmVision">加入这餐（{{visionTotal}} kcal）</button>
    <button class="btn ghost" wx:if="{{visionError}}" bindtap="closeVision">知道了，改用手工记录</button>
  </view>
</view>
